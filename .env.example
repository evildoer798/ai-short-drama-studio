DATABASE_URL="postgresql://shortdrama:shortdrama@localhost:15432/shortdrama?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:14000"

REDIS_HOST="localhost"
REDIS_PORT="16400"
REDIS_PASSWORD=""

S3_ENDPOINT="http://localhost:19100"
S3_REGION="us-east-1"
S3_BUCKET="shortdrama-assets"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

OPENAI_COMPAT_BASE_URL="https://image-provider.example"
OPENAI_COMPAT_API_KEY="replace-with-your-api-key"
IMAGE_MODEL="gpt-image-2"
OPENAI_COMPAT_IMAGE_MODE="images"
IMAGE_QUALITY="low"
IMAGE_SIZE="1024x1024"
IMAGE_OUTPUT_FORMAT="jpeg"
IMAGE_OUTPUT_COMPRESSION="75"
IMAGE_PARTIAL_IMAGES="3"
IMAGE_STREAM="true"
IMAGE_ASYNC="true"
IMAGE_PROVIDER_TIMEOUT_RETRIES="2"
IMAGE_WORKER_CONCURRENCY="1"
IMAGE_WORKER_RATE_LIMIT_MS="15000"

# Primary text provider: DeepSeek.
TEXT_API_BASE_URL="https://primary-text-provider.example/v1"
TEXT_API_KEY="replace-with-your-deepseek-key"
TEXT_API_MODE="chat_completions"
TEXT_MODEL="deepseek-chat"
TEXT_REASONING_EFFORT=""
TEXT_PRIMARY_ONLY="true"
TEXT_PRIMARY_CONCURRENCY_PER_KEY="3"

# Secondary text provider: DeepSeek official API.
TEXT_FALLBACK_API_BASE_URL="https://secondary-text-provider.example/v1"
TEXT_FALLBACK_API_KEY="replace-with-your-deepseek-key"
TEXT_FALLBACK_API_KEY_1="replace-with-your-deepseek-key"
TEXT_FALLBACK_API_MODE="chat_completions"
TEXT_FALLBACK_MODEL="deepseek-chat"
TEXT_FALLBACK_REASONING_EFFORT=""

# Final text provider: Cangyuan gpt-5.5 key pool.
TEXT_TERTIARY_API_BASE_URL="https://tertiary-text-provider.example/v1"
