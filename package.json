{
  "name": "ai-short-drama-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "next dev -H 0.0.0.0 -p 14000",
    "dev:worker": "tsx watch --include .env --env-file=.env src/lib/worker/index.ts",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 14000",
    "start:worker": "tsx --env-file=.env src/lib/worker/index.ts",
    "start:all": "concurrently --kill-others \"npm run start\" \"npm run start:worker\"",
    "test:video-api": "tsx --env-file=.env scripts/test-video-api.ts",
    "test:text-api": "tsx --env-file=.env scripts/test-text-api.ts",
    "test:text-structured": "tsx --env-file=.env scripts/test-deepseek-structured.ts",
    "test:text-chunk": "tsx --env-file=.env scripts/test-text-chunk.ts",
    "resume:text-task": "tsx --env-file=.env scripts/resume-text-task.ts",
    "polish:episodes": "tsx --env-file=.env scripts/polish-short-episodes.ts",
    "configure:text-api": "powershell -ExecutionPolicy Bypass -File ./scripts/configure-cangyuan-text-api.ps1",
    "configure:text-api-pool": "powershell -ExecutionPolicy Bypass -File ./scripts/configure-cangyuan-text-pool.ps1",
    "configure:deepseek-api": "powershell -ExecutionPolicy Bypass -File ./scripts/configure-deepseek-text-api.ps1",
    "generate:asset-video": "tsx --env-file=.env scripts/generate-asset-storyboard-video.ts",
    "generate:action-previews": "tsx --env-file=.env scripts/generate-action-previews.ts",
    "generate:grok-real-video": "tsx --env-file=.env scripts/generate-grok-real-storyboard-video.ts",
    "import:existing-video": "tsx --env-file=.env scripts/import-existing-storyboard-video.ts",
    "cloudflare:configure": "powershell -ExecutionPolicy Bypass -File ./scripts/configure-cloudflare.ps1",
    "cloudflare:test-storage": "tsx --env-file=.env.cloudflare scripts/test-r2-storage.ts",
    "cloudflare:migrate-media": "tsx --env-file=.env.cloudflare scripts/migrate-media-to-r2.ts",
    "cloudflare:tunnel": "docker compose --env-file .env.cloudflare -f docker-compose.tunnel.yml up -d",
    "cloudflare:tunnel:logs": "docker compose --env-file .env.cloudflare -f docker-compose.tunnel.yml logs -f cloudflared",
    "cloudflare:tunnel:stop": "docker compose --env-file .env.cloudflare -f docker-compose.tunnel.yml down",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "tsx src/scripts/seed.ts",
    "provision:users": "tsx --env-file=.env scripts/provision-team-users.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.67.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.575.0",
    "next": "^16.2.10",
    "prisma": "^6.19.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
