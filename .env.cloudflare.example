CLOUDFLARE_TUNNEL_TOKEN="replace-with-your-tunnel-token"
CLOUDFLARE_PUBLIC_URL="https://studio.example.com"
CLOUDFLARE_ACCOUNT_ID="replace-with-your-account-id"

S3_ENDPOINT="https://replace-with-your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="shortdrama-assets"
S3_ACCESS_KEY_ID="replace-with-your-r2-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-your-r2-secret-access-key"
S3_FORCE_PATH_STYLE="false"

# Source MinIO settings used only by cloudflare:migrate-media.
SOURCE_S3_ENDPOINT="http://localhost:19100"
SOURCE_S3_REGION="us-east-1"
SOURCE_S3_BUCKET="shortdrama-assets"
SOURCE_S3_ACCESS_KEY_ID="minioadmin"
SOURCE_S3_SECRET_ACCESS_KEY="minioadmin"
SOURCE_S3_FORCE_PATH_STYLE="true"
